+async def _should_route_decode_only(request: dict, decode_server: str, endpoint: str) -> bool:
+    threshold = getattr(lb, "short_prefill_threshold", 0)
+    if threshold <= 0:
+        return False
+
+    prompt_len = await _get_prompt_len(request, decode_server, endpoint)
+    return prompt_len is not None and prompt_len < threshold
+
+
+async def _get_prompt_len(request: dict, decode_server: str, endpoint: str):
+    input_ids = request.get("input_ids")
+    if input_ids is not None:
+        if len(input_ids) == 0:
+            return 0
+        if isinstance(input_ids[0], int):
+            return len(input_ids)
+        return max(len(ids) for ids in input_ids)
+
+    tokenize_payload = None
+    if "text" in request:
+        tokenize_payload = {"prompt": request["text"], "add_special_tokens": False}
+    elif endpoint == "v1/completions" and "prompt" in request:
+        tokenize_payload = {"prompt": request["prompt"], "add_special_tokens": False}
+    elif endpoint == "v1/chat/completions" and "messages" in request:
+        tokenize_payload = {"messages": request["messages"]}
+
+    if tokenize_payload is None:
+        return None
+
+    try:
+        async with aiohttp.ClientSession(
+            timeout=aiohttp.ClientTimeout(total=min(lb.timeout, 30))
+        ) as session:
+            async with session.post(f"{decode_server}/tokenize", json=tokenize_payload) as resp:
+                if resp.status != 200:
+                    logger.warning("[MiniLB] Tokenize failed with status %s", resp.status)
+                    return None
+                data = await resp.json()
+    except Exception:
+        logger.warning("[MiniLB] Tokenize failed", exc_info=True)
+        return None
+
+    count = data.get("count")
+    if isinstance(count, int):
+        return count
+    if isinstance(count, list) and count:
+        return max(count)
+    return None
+
+
 def _generate_bootstrap_room():
     return random.randint(0, 2**63 - 1)
 
