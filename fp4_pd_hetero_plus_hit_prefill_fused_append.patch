+def fp4_mla_staging_nbytes(num_tokens: int, kv_cache_dim: int, num_layers: int) -> int:
+    packed_dim = kv_cache_dim // 2
+    scale_dim = kv_cache_dim // 16
+    return num_tokens * (packed_dim + scale_dim) * num_layers
+
+
+def gather_fp4_mla_to_staging(
+    data_buffers: list,
+    scale_buffers: list,
+    page_indices_np,
+    staging_buffer: StagingBuffer,
+    page_size: int,
+    gpu_id: int,
+) -> int:
+    """Gather FP4 MLA packed data and scale buffers into contiguous staging.
+
+    Layout per layer is [packed_data for all tokens][scale bytes for all tokens].
+    """
+    import numpy as np
+
+    num_layers = len(data_buffers)
+    assert num_layers == len(scale_buffers)
+    packed_dim = data_buffers[0].shape[-1]
+    scale_dim = scale_buffers[0].shape[-1]
+    num_tokens = len(page_indices_np) * page_size
+    data_bytes = num_tokens * packed_dim
+    per_layer_bytes = data_bytes + num_tokens * scale_dim
+    total_bytes = per_layer_bytes * num_layers
+
+    device = f"cuda:{gpu_id}"
+    torch.cuda.set_device(gpu_id)
+    page_idx_tensor = torch.from_numpy(page_indices_np.astype(np.int64)).to(device)
+
+    data_ptrs = torch.tensor(
+        [buf.data_ptr() for buf in data_buffers], dtype=torch.int64, device=device
+    )
+    scale_ptrs = torch.tensor(
+        [buf.data_ptr() for buf in scale_buffers], dtype=torch.int64, device=device
+    )
+
+    if not hasattr(staging_buffer, "_gather_stream"):
+        staging_buffer._gather_stream = torch.cuda.Stream(device=device)
+
+    staging_buffer._gather_stream.wait_stream(
+        torch.cuda.default_stream(torch.device(device))
+    )
+
+    BLOCK_SIZE = 1024
+    grid = (num_layers, triton.cdiv(per_layer_bytes, BLOCK_SIZE))
+    with torch.cuda.stream(staging_buffer._gather_stream):
+        _gather_fp4_mla_to_staging_kernel[grid](
+            data_ptrs,
+            scale_ptrs,
+            page_idx_tensor,
+            staging_buffer.buffer,
+            per_layer_bytes,
+            data_bytes,
+            num_tokens,
+            packed_dim,
+            scale_dim,
+            page_size,
+            BLOCK_SIZE,
+        )
+
+    staging_buffer._gather_stream.synchronize()
+    return total_bytes
+
+
+def transcode_fp4_mla_staging_to_fp8_kv(
+    staging_buffer_view: torch.Tensor,
+    kv_buffers: list,
+    page_idx_tensor: torch.Tensor,
+    page_size: int,
+    kv_cache_dim: int,
+) -> None:
+    """Transcode staged block-FP4 MLA KV directly into FP8 KV cache buffers."""
+    num_layers = len(kv_buffers)
+    num_tokens = page_idx_tensor.shape[0] * page_size
+    packed_dim = kv_cache_dim // 2
+    scale_dim = kv_cache_dim // 16
+    data_bytes = num_tokens * packed_dim
+    per_layer_bytes = data_bytes + num_tokens * scale_dim
+
+    BLOCK_SIZE = 1024
+    dst_ptr_key = tuple(kv.data_ptr() for kv in kv_buffers)
+    dst_ptrs = _FP4_MLA_DST_PTRS_CACHE.get(dst_ptr_key)
+    if dst_ptrs is None or dst_ptrs.device != page_idx_tensor.device:
+        dst_ptrs = torch.tensor(
+            dst_ptr_key, dtype=torch.int64, device=page_idx_tensor.device
+        )
+        _FP4_MLA_DST_PTRS_CACHE[dst_ptr_key] = dst_ptrs
+    grid = (num_layers, triton.cdiv(num_tokens * kv_cache_dim, BLOCK_SIZE))
+    _fp4_mla_staging_to_fp8_kernel[grid](
+        staging_buffer_view,
+        dst_ptrs,
+        page_idx_tensor,
+        per_layer_bytes,
+        data_bytes,
+        num_tokens,
+        packed_dim,
+        scale_dim,
+        kv_cache_dim,
+        page_size,
+        tl.float8e4nv,
+        BLOCK_SIZE,
+    )
+
