+@triton.jit
+def _gather_fp4_mla_to_staging_kernel(
+    data_ptrs,
+    scale_ptrs,
+    page_indices,
+    staging,
+    per_layer_bytes,
+    data_bytes,
+    num_tokens,
+    packed_dim,
+    scale_dim,
+    PAGE_SIZE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    layer_id = tl.program_id(0)
+    block_id = tl.program_id(1)
+
+    data_ptr = tl.load(data_ptrs + layer_id).to(staging.dtype)
+    scale_ptr = tl.load(scale_ptrs + layer_id).to(staging.dtype)
+
+    offsets = block_id * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    mask = offsets < per_layer_bytes
+    is_data = offsets < data_bytes
+
+    scale_offsets = offsets - data_bytes
+    t_idx = tl.where(is_data, offsets // packed_dim, scale_offsets // scale_dim)
+    e_idx = tl.where(is_data, offsets % packed_dim, scale_offsets % scale_dim)
+
+    page_id = t_idx // PAGE_SIZE
+    intra_page = t_idx % PAGE_SIZE
+    page_val = tl.load(page_indices + page_id, mask=mask, other=0)
+    pool_token = page_val * PAGE_SIZE + intra_page
+
+    src_offsets = tl.where(
+        is_data,
+        pool_token * packed_dim + e_idx,
+        pool_token * scale_dim + e_idx,
+    )
+    src_ptr = tl.where(is_data, data_ptr, scale_ptr)
+    vals = tl.load(src_ptr + src_offsets, mask=mask)
+
+    dst_offsets = layer_id.to(tl.int64) * per_layer_bytes.to(tl.int64) + offsets
+    tl.store(staging + dst_offsets, vals, mask=mask)
+
+
+@triton.jit
+def _fp4_mla_staging_to_fp8_layer_kernel(
+    staging,
+    dst,
+    page_indices,
+    layer_offset,
+    data_bytes,
+    num_tokens,
+    packed_dim: tl.constexpr,
+    scale_dim: tl.constexpr,
+    kv_dim: tl.constexpr,
+    PAGE_SIZE: tl.constexpr,
+    FP8_DTYPE: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    offsets = tl.program_id(0) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    total = num_tokens * kv_dim
+    mask = offsets < total
+
+    t_idx = offsets // kv_dim
+    dim = offsets % kv_dim
+
+    page_id = t_idx // PAGE_SIZE
+    intra_page = t_idx % PAGE_SIZE
+    page_val = tl.load(page_indices + page_id, mask=mask, other=0)
+    pool_token = page_val * PAGE_SIZE + intra_page
+
+    packed = tl.load(
+        staging + layer_offset + t_idx * packed_dim + (dim // 2),
+        mask=mask,
+        other=0,
+    )
+    nibble = tl.where((dim % 2) == 0, packed & 0x0F, (packed >> 4) & 0x0F)
+    mag = nibble & 0x07
+    sign = (nibble & 0x08) != 0
+
+    # E2M1 codebook: [0, 0.5, 1, 1.5, 2, 3, 4, 6]
+    val = tl.where(
+        mag == 0,
+        0.0,
+        tl.where(
+            mag == 1,
+            0.5,
+            tl.where(
+                mag == 2,
+                1.0,
+                tl.where(
+                    mag == 3,
+                    1.5,
+                    tl.where(
+                        mag == 4,
+                        2.0,
+                        tl.where(mag == 5, 3.0, tl.where(mag == 6, 4.0, 6.0)),
+                    ),
+                ),
+            ),
+        ),
+    )
+    val = tl.where(sign, -val, val)
+
+    scale = tl.load(
+        staging + layer_offset + data_bytes + t_idx * scale_dim + (dim // 16),
+        mask=mask,
+        other=127,
+    )
+    val = val * tl.exp2(scale.to(tl.float32) - 127.0)
+
+    tl.store(dst + pool_token * kv_dim + dim, val.to(FP8_DTYPE), mask=mask)
+
