+@triton.jit
+def _fp4_e2m1_quantize(vals):
+    abs_vals = tl.abs(vals)
+    mag = (abs_vals >= 0.25).to(tl.uint32)
+    mag += (abs_vals >= 0.75).to(tl.uint32)
+    mag += (abs_vals >= 1.25).to(tl.uint32)
+    mag += (abs_vals >= 1.75).to(tl.uint32)
+    mag += (abs_vals >= 2.5).to(tl.uint32)
+    mag += (abs_vals >= 3.5).to(tl.uint32)
+    mag += (abs_vals >= 5.0).to(tl.uint32)
+    sign = (vals < 0.0).to(tl.uint32) << 3
+    return sign | mag
+
+
+@triton.jit
+def _load_mla_value(
+    cache_k_nope_ptr,
+    cache_k_rope_ptr,
+    pid_loc,
+    offs,
+    nope_stride: tl.constexpr,
+    rope_stride: tl.constexpr,
+    nope_dim: tl.constexpr,
+    total_dim: tl.constexpr,
+):
+    mask = offs < total_dim
+    is_nope = offs < nope_dim
+    src_nope = tl.load(
+        cache_k_nope_ptr + pid_loc * nope_stride + offs,
+        mask=mask & is_nope,
+        other=0.0,
+    )
+    src_rope = tl.load(
+        cache_k_rope_ptr + pid_loc * rope_stride + (offs - nope_dim),
+        mask=mask & ~is_nope,
+        other=0.0,
+    )
+    return tl.where(is_nope, src_nope, src_rope).to(tl.float32)
+
+
+@triton.jit
+def set_mla_kv_buffer_fp4_quant_scatter_kernel(
+    kv_buffer_ptr,
+    kv_scale_buffer_ptr,
+    cache_k_nope_ptr,
+    cache_k_rope_ptr,
+    loc_ptr,
+    buffer_stride: tl.constexpr,
+    scale_stride: tl.constexpr,
+    nope_stride: tl.constexpr,
+    rope_stride: tl.constexpr,
+    nope_dim: tl.constexpr,
+    rope_dim: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    pid_loc = tl.program_id(0)
+    pid_block = tl.program_id(1)
+
+    total_dim: tl.constexpr = nope_dim + rope_dim
+    pair = tl.arange(0, 8)
+    offs_even = pid_block * BLOCK_SIZE + pair * 2
+    offs_odd = offs_even + 1
+
+    even = _load_mla_value(
+        cache_k_nope_ptr,
+        cache_k_rope_ptr,
+        pid_loc,
+        offs_even,
+        nope_stride,
+        rope_stride,
+        nope_dim,
+        total_dim,
+    )
+    odd = _load_mla_value(
+        cache_k_nope_ptr,
+        cache_k_rope_ptr,
+        pid_loc,
+        offs_odd,
+        nope_stride,
+        rope_stride,
+        nope_dim,
+        total_dim,
+    )
+
+    block_max = tl.maximum(tl.max(tl.abs(even), axis=0), tl.max(tl.abs(odd), axis=0))
+    scale_exp = tl.ceil(tl.log2(tl.maximum(block_max / 6.0, 1.0e-10)))
+    inv_scale = 1.0 / tl.exp2(scale_exp)
+    low = _fp4_e2m1_quantize(even * inv_scale)
+    high = _fp4_e2m1_quantize(odd * inv_scale)
+    packed = low | (high << 4)
+
+    loc = tl.load(loc_ptr + pid_loc).to(tl.int64)
+    packed_base = pid_block * 8
+    packed_mask = offs_odd < total_dim
+    tl.store(
+        kv_buffer_ptr + loc * buffer_stride + packed_base + pair,
+        packed,
+        mask=packed_mask,
+    )
+    tl.store(
+        kv_scale_buffer_ptr + loc * scale_stride + pid_block,
+        (scale_exp + 127.0).to(tl.uint8),
+        mask=pid_block < tl.cdiv(total_dim, BLOCK_SIZE),
+    )
