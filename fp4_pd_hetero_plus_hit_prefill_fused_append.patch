+def set_mla_kv_buffer_fp4_quant_scatter_triton(
+    kv_buffer: torch.Tensor,
+    kv_scale_buffer: torch.Tensor,
+    loc: torch.Tensor,
+    cache_k_nope: torch.Tensor,
+    cache_k_rope: torch.Tensor,
