+        0.0,
+        tl.where(
+            magnitude == 1,
+            0.5,
+            tl.where(
+                magnitude == 2,
+                1.0,
+                tl.where(
+                    magnitude == 3,
+                    1.5,
+                    tl.where(
+                        magnitude == 4,
+                        2.0,
+                        tl.where(
+                            magnitude == 5, 3.0, tl.where(magnitude == 6, 4.0, 6.0)
+                        ),
+                    ),
+                ),
+            ),
+        ),
+    )
+    return tl.where((fp4_vals & 0x08) != 0, -values, values)
